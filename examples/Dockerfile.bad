FROM python:latest
MAINTAINER dev@example.com
ENV API_KEY=sk-live-not-a-real-key
RUN apt-get update
RUN sudo apt-get install -y curl
ADD https://example.com/install.sh /tmp/install.sh
RUN curl -s https://example.com/setup | sh
WORKDIR app
COPY . /app
RUN pip install -r requirements.txt
USER root
CMD ["python", "-m", "app.cli"]
